# ─────────────────────────────────────────────────────────────────────────────
# Imera Elektro — Ortam Değişkenleri (Hostinger / production)
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun. .env git'e GİRMEZ.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
# PORT: Hostinger/Passenger otomatik atar; boş bırakılabilir. Lokal için 3000.
PORT=3000

# Oturum imzalama anahtarı — uzun, rastgele bir string koyun
SESSION_SECRET=change-this-to-a-long-random-string

# ─── Veritabanı: Turso (production) ──────────────────────────────────────────
# Bu ikisi tanımlıysa uygulama Turso kullanır; boşsa lokal SQLite dosyası.
# Taşımada yeni Turso hesabındaki db url + token ile değiştirin.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Görsel yükleme: Cloudinary ──────────────────────────────────────────────
# Üç ayrı değer VEYA tek CLOUDINARY_URL (biri yeterli). Taşımada yeni hesabın
# değerleriyle değiştirin, sonra: node scripts/migrate-cloudinary.js --apply
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ─── Ödeme: Stripe (LIVE anahtar) ────────────────────────────────────────────
# Not: publishable key koda/env'e değil, Admin → Ayarlar'da (stripe_publishable_key) tutulur.
STRIPE_SECRET_KEY=

# ─── E-Posta (SMTP) — Hostinger mail ─────────────────────────────────────────
SMTP_HOST=mail.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@imeragroup.com
SMTP_PASS=
# Gönderen adresi; boşsa SMTP_USER kullanılır.
MAIL_FROM=info@imeragroup.com
# İletişim formu bildirimlerinin gideceği adres; boşsa info@imeragroup.com.
CONTACT_EMAIL=info@imeragroup.com

# ─── Banka / Havale (sipariş onayı, PDF fatura, e-posta) ─────────────────────
# Boş bırakılırsa koddaki config/bank.js varsayılanları kullanılır.
BANK_IBAN=
BANK_HOLDER=

# ─── Admin & çeşitli ─────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@imeraelektro.at
ADMIN_PASSWORD=
# Sipariş mailindeki admin linki için canlı adres
SITE_URL=https://www.imeragroup.com
# Geçici import/bakım endpoint'lerini (/__pawbol, /__karlik vb.) korur.
# Tanımsızsa bu endpoint'ler 403 döner (kapalı) — normal çalışmada gerekmez.
IMPORT_TOKEN=
