<%- include('../partials/header') %>
<%
  const brandAccents = { onka:'#1E5AAB', tork:'#E8720C', tracon:'#C0392B', karlik:'#0E9AA7', pawbol:'#2563A6' };
  const accent = brandAccents[brand.slug] || '#166534';
  const isPartner = typeof isPartnerBrand === 'function' && isPartnerBrand(brand.slug);
  const lieferText = isPartner ? 'ca. 1 Woche' : '1–2 Werktage';
  const wareText = isPartner ? 'Partnerware' : 'Lagerware';
%>
<style>
  .brand-page { --accent: <%= accent %>; }
  .brand-hero { position:relative; overflow:hidden; border:1px solid var(--border,#E5E7EB); border-left:5px solid var(--accent);
    border-radius:18px; padding:1.75rem; margin-bottom:1.5rem; background:#fff;
    background:linear-gradient(120deg, color-mix(in srgb, var(--accent) 8%, #fff), #fff 62%); }
  .brand-hero-top { display:flex; align-items:center; gap:1.25rem; flex-wrap:wrap; }
  .brand-hero-logo { min-height:56px; min-width:120px; display:flex; align-items:center; }
  .brand-hero img { max-height:60px; max-width:180px; width:auto; object-fit:contain; }
  .brand-hero-logo .noimg { font-size:30px; font-weight:800; letter-spacing:.5px; color:var(--accent); }
  .brand-hero h1 { margin:0 0 .35rem; font-size:28px; }
  .brand-hero p { margin:0; color:#4B5563; font-size:14.5px; line-height:1.6; max-width:62ch; }
  .brand-badge { display:inline-flex; align-items:center; gap:6px; font-size:12px; font-weight:700; padding:4px 11px; border-radius:999px;
    color:var(--accent); background:color-mix(in srgb, var(--accent) 12%, #fff); border:1px solid color-mix(in srgb, var(--accent) 30%, #fff); margin-bottom:.6rem; }
  .brand-stats { display:flex; flex-wrap:wrap; gap:.6rem; margin-top:1.15rem; }
  .brand-stat { flex:1; min-width:120px; background:#fff; border:1px solid var(--border,#E5E7EB); border-radius:12px; padding:11px 14px; }
  .brand-stat b { display:block; font-size:19px; color:var(--accent); line-height:1.1; }
  .brand-stat small { font-size:12px; color:#6B7280; }
  .brand-downloads { border:1px solid #BBF7D0; background:#F0FDF4; border-radius:14px; padding:1.15rem 1.25rem; margin-bottom:1.5rem; }
  .brand-downloads h2 { font-size:16px; margin:0 0 .75rem; }
  .brand-dl-list { display:flex; flex-wrap:wrap; gap:.6rem; }
  .brand-dl { display:inline-flex; align-items:center; gap:8px; background:#fff; border:1px solid #BBF7D0; border-radius:10px;
    padding:9px 14px; font-size:13px; font-weight:500; color:#166534; }
  .brand-dl:hover { border-color:#34C759; color:#166534; }
  .bp-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:1rem; }
  .bp-card { border:1px solid var(--border,#E5E7EB); border-radius:14px; overflow:hidden; background:#fff; display:flex; flex-direction:column;
    text-decoration:none; color:inherit; transition:box-shadow .18s, transform .18s, border-color .18s; }
  .bp-card:hover { transform:translateY(-3px); box-shadow:0 10px 26px rgba(0,0,0,.09); border-color:color-mix(in srgb, var(--accent) 45%, #fff); }
  .bp-img { aspect-ratio:1/1; display:flex; align-items:center; justify-content:center; background:#F9FAFB; overflow:hidden; }
  .bp-img img { width:100%; height:100%; object-fit:contain; padding:10px; }
  .bp-body { padding:.75rem .9rem 1rem; display:flex; flex-direction:column; gap:.3rem; }
  .bp-cat { font-size:11px; color:#6B7280; text-transform:uppercase; letter-spacing:.4px; }
  .bp-name { font-size:14px; font-weight:600; line-height:1.35; }
  .bp-price { font-size:14px; font-weight:700; color:var(--accent); margin-top:.2rem; }
  @media (max-width:480px){ .bp-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; } }
  .brand-filter { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1.25rem; }
  .brand-chip { display:inline-flex; align-items:center; gap:6px; padding:8px 14px; border:1px solid var(--border,#E5E7EB);
    border-radius:999px; font-size:13px; font-weight:500; color:#374151; background:#fff; text-decoration:none; white-space:nowrap; }
  .brand-chip:hover { border-color:var(--accent); color:var(--accent); }
  .brand-chip.active { background:var(--accent); color:#fff; border-color:var(--accent); }
  .brand-chip .c { opacity:.6; font-size:12px; }
  .brand-chip.active .c { opacity:.85; }
</style>
<main>
  <div class="container page-content brand-page">
    <nav class="breadcrumb"><a href="/">Startseite</a> › <a href="/marken">Marken</a> › <%= brand.name %></nav>

    <div class="brand-hero">
      <div class="brand-hero-top">
        <div class="brand-hero-logo">
          <% if (brand.logo) { %><img src="<%= brand.logo %>" alt="<%= brand.name %> Logo"><% } else { %><span class="noimg"><%= brand.name %></span><% } %>
        </div>
        <div style="min-width:0;flex:1">
          <span class="brand-badge">✓ <%= wareText %> · Lieferung <%= lieferText %></span>
          <h1><%= brand.name %> Produkte</h1>
          <p><%= brand.description || (brand.name + ' Produkte im B2B-Großhandel – CE-konform und normkonform, direkt vom Hersteller für Geschäftskunden in Österreich.') %></p>
        </div>
      </div>
      <div class="brand-stats">
        <div class="brand-stat"><b><%= totalAll %></b><small>Produkte im Sortiment</small></div>
        <% if (brandCats && brandCats.length) { %><div class="brand-stat"><b><%= brandCats.length %></b><small>Kategorien</small></div><% } %>
        <div class="brand-stat"><b><%= lieferText %></b><small>Lieferzeit</small></div>
        <div class="brand-stat"><b>CE</b><small>konforme Markenware</small></div>
      </div>
    </div>

    <% if (catalogs && catalogs.length) { %>
    <div class="brand-downloads">
      <h2>📄 Kataloge &amp; Downloads</h2>
      <div class="brand-dl-list">
        <% for (const c of catalogs) { %>
        <a href="<%= c.file_url %>" target="_blank" rel="noopener" class="brand-dl">📄 <%= c.title %></a>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (brandCats && brandCats.length > 1) { %>
    <div class="brand-filter">
      <a href="/marken/<%= brand.slug %>" class="brand-chip <%= !activeKat ? 'active' : '' %>">Alle <span class="c"><%= totalAll %></span></a>
      <% for (const c of brandCats) { %>
      <a href="/marken/<%= brand.slug %>?kategorie=<%= c.slug %>" class="brand-chip <%= activeKat === c.slug ? 'active' : '' %>"><%= c.name %> <span class="c"><%= c.cnt %></span></a>
      <% } %>
    </div>
    <% } %>

    <div style="margin-bottom:1rem">
      <h2 style="margin:0 0 .9rem;font-size:18px">Produkte von <%= brand.name %> <span style="color:#6B7280;font-weight:400">(<%= total %>)</span></h2>
      <div style="text-align:center">
        <a href="/shop?marke=<%= brand.slug %><%= activeKat ? '&kategorie=' + activeKat : '' %>" class="btn-blue btn-sm">Alle im Shop ansehen →</a>
      </div>
    </div>

    <% if (!products.length) { %>
      <p class="text-gray">Für diese Marke sind derzeit keine Produkte verfügbar.</p>
    <% } else { %>
    <div class="bp-grid">
      <% for (const p of products) { %>
      <a href="/shop/produkt/<%= p.slug %>" class="bp-card">
        <div class="bp-img">
          <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.name %> – <%= brand.name %>" loading="lazy">
          <% } else { %><span style="font-size:2rem">📦</span><% } %>
        </div>
        <div class="bp-body">
          <% if (p.cat_name) { %><span class="bp-cat"><%= p.cat_name %></span><% } %>
          <span class="bp-name"><%= p.name %></span>
          <% if (p.price_min) { %><span class="bp-price">ab <%= formatEuro(p.price_min) %></span><% } %>
        </div>
      </a>
      <% } %>
    </div>
    <% if (total > products.length) { %>
    <p style="text-align:center;margin-top:1.5rem"><a href="/shop?marke=<%= brand.slug %><%= activeKat ? '&kategorie=' + activeKat : '' %>" class="btn-blue">Alle <%= total %> Produkte ansehen →</a></p>
    <% } %>
    <% } %>
  </div>
</main>
<%- include('../partials/footer') %>
